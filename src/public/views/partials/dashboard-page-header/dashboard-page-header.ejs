<link rel="stylesheet" href="/partials/dashboard-page-header/dashboard-page-header.css">

<header class="content-head page-header" data-mobile-restricted="<%= isRestrictedOnMobile ? 'true' : 'false' %>">
    <div class="page-header-inner">
        <div class="icon-square">
            <i class="<%= icon %>"></i>
        </div>
        <div class="header-text">
            <h1><%= title %></h1>
            <p><%= description %></p>
        </div>
    </div>

    <button class="pin-toggle" id="pinToggleBtn" title="Pin this view">
        <i class="fas fa-thumbtack"></i>
    </button>
</header>

<script src="/partials/dashboard-page-header/dashboard-page-header.js" defer></script>
